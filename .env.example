# Blaaiz Sandbox Infrastructure Configuration (GDG Ilorin Buildathon)
BLAAIZ_API_URL=https://api-dev.blaaiz.com
BLAAIZ_CLIENT_ID=your_blaaiz_client_id_here
BLAAIZ_CLIENT_SECRET=your_blaaiz_client_secret_here
BLAAIZ_API_KEY=your_blaaiz_api_key_or_bearer_token
BLAAIZ_WEBHOOK_SECRET=sendlock-demo-secret

# Set to false to send live HTTP requests to api-dev.blaaiz.com
MOCK_MODE=false

PORT=4000
DATABASE_URL=file:./dev.db
